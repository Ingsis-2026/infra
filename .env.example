# Copiar a .env y completar. El .env no se versiona. En las VMs, usar contraseñas fuertes.
# Los valores de las bases coinciden con los defaults de cada servicio, para correr uno desde el IDE sin configurar nada.

# dev o prod: qué imágenes de ghcr.io/ingsis-2026 se levantan. En cada VM va la de su entorno.
IMAGE_TAG=prod

SNIPPET_DB_NAME=snippet
SNIPPET_DB_USER=snippet
SNIPPET_DB_PASSWORD=snippet

PERMISSION_DB_NAME=permission
PERMISSION_DB_USER=permission
PERMISSION_DB_PASSWORD=permission

# Solo en las VMs. El dominio queda <DUCKDNS_SUBDOMAIN>.duckdns.org: uno para dev y otro para prod.
# El token está arriba de todo en duckdns.org, una vez logueado. No lo subas a ningún lado.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Opcional: Let's Encrypt avisa ahí si el certificado está por vencer y no se renovó.
LETSENCRYPT_EMAIL=

# Puertos en tu máquina. Cambialos si alguno ya está ocupado.
PROXY_PORT=80
SNIPPET_SERVICE_PORT=8080
PERMISSION_SERVICE_PORT=8081
LANGUAGE_SERVICE_PORT=8082
ASSET_SERVICE_PORT=8083

# La aplicación machine-to-machine de Auth0 con read:users, para buscar con quién compartir un snippet (US7).
# Sin ellas, snippet-service anda igual pero no puede listar usuarios. El secret no se commitea nunca.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
