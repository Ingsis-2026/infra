# Solo para correr todo en tu máquina con docker compose: copiar a .env y completar. El .env no se versiona.
# Las VMs no usan .env: ver "Deploy en las VMs" en el README.
# Los valores de las bases coinciden con los defaults de cada servicio, para correr uno desde el IDE sin configurar nada.

# dev o prod: qué imágenes de ghcr.io/ingsis-2026 se levantan.
IMAGE_TAG=prod

SNIPPET_DB_NAME=snippet
SNIPPET_DB_USER=snippet
SNIPPET_DB_PASSWORD=snippet

PERMISSION_DB_NAME=permission
PERMISSION_DB_USER=permission
PERMISSION_DB_PASSWORD=permission

# Puertos en tu máquina. Cambialos si alguno ya está ocupado.
PROXY_PORT=80
SNIPPET_SERVICE_PORT=8080
PERMISSION_SERVICE_PORT=8081
LANGUAGE_SERVICE_PORT=8082
ASSET_SERVICE_PORT=8083

# La aplicación machine-to-machine de Auth0 de snippet-service: busca con quién compartir un snippet (US7)
# y pide el token con el que llama a permission-service y language-service. Sin ellas, snippet-service anda
# igual pero no puede listar usuarios. El secret no se commitea nunca.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# true para que permission-service y language-service pidan el token de snippet-service, como en las VMs.
# Necesita la aplicación machine-to-machine de arriba.
INTERNAL_AUTH_ENABLED=false
