# Copiar a .env y completar. El .env no se versiona.
# Los valores de las bases coinciden con los defaults de cada servicio, para correr uno desde el IDE sin configurar nada.
# En las VMs, cambiar todas las contraseñas.

# dev o prod: qué imágenes de ghcr.io/ingsis-2026 levanta esta VM.
IMAGE_TAG=dev

SNIPPET_DB_NAME=snippet
SNIPPET_DB_USER=snippet
SNIPPET_DB_PASSWORD=snippet

PERMISSION_DB_NAME=permission
PERMISSION_DB_USER=permission
PERMISSION_DB_PASSWORD=permission

# Auth0: se completa cuando la cátedra lo presente.
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=https://snippet-searcher
